results/cytogpnet/*/*.obj
results/cytogpnet/*/fold*/*.obj
results/cytogpnet/*/ae_output/*.pth
results/cytogpnet/*/model_output/*.pth

# LaTeX build artifacts
docs/latex/*.aux
docs/latex/*.log
docs/latex/*.out
docs/latex/*.toc
